{
  "name": "learn-and-play-tv-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android",
    "web": "expo start --web --port 8082",
    "prebuild": "EXPO_TV=1 expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-tvos/config-tv": "0.1.6",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.0",
    "expo-status-bar": "~3.0.0",
    "mitt": "3.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-2",
    "react-native-keyevent": "0.3.2",
    "react-native-pixel-perfect": "1.0.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "@expo/metro-runtime": "~6.1.2",
    "react-tv-space-navigation": "6.0.0-beta1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
