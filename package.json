{
  "name": "firetv-learning-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc",
    "build:preview": "esbuild src/ui/main.tsx --bundle --outfile=preview/bundle.js --jsx=automatic --loader:.json=json --define:process.env.NODE_ENV='\"production\"'",
    "preview": "npm run build:preview && npx --yes http-server preview -p 5173",
    "app:install": "cd app && npm install --legacy-peer-deps",
    "app:web": "cd app && npx expo start --web --port 8082",
    "app:typecheck": "cd app && npx tsc --noEmit",
    "app:android": "cd app && npm run prebuild && npm run android",
    "gen:map": "node scripts/gen-map.mjs",
    "gen:audio": "node scripts/gen-audio.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
